{
  "manifest_version": 3,
  "name": "LHIMS Referral Assist",
  "version": "0.3.0",
  "description": "Assists and automates attaching referral forms in LHIMS. Local only.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://attach-hfch.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "config.js",
        "relay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://10.10.16.50/lhims_*/*"
      ],
      "js": [
        "dialogs.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://10.10.16.50/lhims_*/*"
      ],
      "js": [
        "config.js",
        "badge.js",
        "lhims.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}